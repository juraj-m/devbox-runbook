#!/usr/bin/env bash
# git credential helper: answers github.com requests with the repo's own
# token if there is one, else its owner's (see devbox-github). Needs credential.useHttpPath, so git
# sends the path (OWNER/REPO.git) and not just the host.
[ "${1:-}" = get ] || exit 0
host="" path=""
while IFS= read -r line && [ -n "$line" ]; do
	case $line in
	host=*) host=${line#host=} ;;
	path=*) path=${line#path=} ;;
	esac
done
[ "$host" = github.com ] && [ -n "$path" ] || exit 0
repo=${path#*/}
repo=${repo%%/*}
t=$(devbox-github token "${path%%/*}/${repo%.git}") || exit 0
# GitHub ignores the username when the password is a token.
printf 'username=x-access-token\npassword=%s\n' "$t"
